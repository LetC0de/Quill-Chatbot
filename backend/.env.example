GEMINI_API_KEY=your_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-embed-2312

# Qdrant Cloud cluster
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# PostgreSQL 
DB_CONNECTION=postgresql://user:pass@host/dbname?sslmode=require

CORS_ORIGINS=["https://your-frontend_url","http://localhost:5173","http://127.0.0.1:5173"]

# Primary frontend origin
FRONTEND_URL=https://your-frontend_url

SECRET_KEY=your_jwt_secret_key
ALGORITHM=HS256
